  },
  "checkFact": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "name",
    "type"
   ],
   "properties": {
    "name": {
     "type": "string",
     "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "type": {
     "$ref": "#/$defs/checkFactType"
    },
    "cardinality": {
     "enum": [
      "one",
      "many"
     ]
    },
    "description": {
     "$ref": "#/$defs/text"
    }
   }
  },
  "checkScalar": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "integer"
    },
    {
     "type": "boolean"
    }
   ]
  },
  "checkExpected": {
   "anyOf": [
    {
     "$ref": "#/$defs/checkScalar"
    },
    {
     "type": "array",
     "items": {
      "$ref": "#/$defs/checkScalar"
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "param"
     ],
     "properties": {
      "param": {
       "type": "string",
       "minLength": 1
      }
     }
    }
   ]
  },
  "checkAssertion": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "fact",
    "op"
   ],
   "properties": {
    "fact": {
     "type": "string",
     "minLength": 1
    },
    "op": {
     "$ref": "#/$defs/checkOp"
    },
    "expected": {
     "$ref": "#/$defs/checkExpected"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "op": {
        "enum": [
         "present",
         "absent"
        ]
       }
      },
      "required": [
       "op"
      ]
     },
     "then": {
      "not": {
       "required": [
        "expected"
       ]
      }
     },
     "else": {
      "required": [
       "expected"
      ]
     }
    }
   ]
  },
  "checkObservation": {
   "oneOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "facts"
     ],
     "properties": {
      "facts": {
       "type": "object"
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "resources"
     ],
     "properties": {
      "resources": {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "id",
         "facts"
        ],
        "properties": {
         "id": {
          "type": "string",
          "minLength": 1
         },
         "facts": {
          "type": "object"
         }
        }
       }
      }
     }
    }
   ]
  },
  "checkOutcome": {
   "enum": [
    "satisfied",
    "not-satisfied",
    "inconclusive",
    "not-applicable"
   ]
  },
  "checkResult": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "check-ref",
    "check-digest",
    "outcome",
    "time"
   ],
   "properties": {
    "check-ref": {
     "$ref": "#/$defs/uri"
    },
    "check-digest": {
     "$ref": "#/$defs/digest"
    },
    "collector-id": {
     "type": "string",
     "minLength": 1
    },
    "outcome": {
     "$ref": "#/$defs/checkOutcome"
    },
    "time": {
     "$ref": "#/$defs/dateTime"
    },
    "parameters": {
     "type": "object",
     "minProperties": 1
    },
    "observation": {
     "$ref": "#/$defs/checkObservation"
    },
    "observation-ref": {
     "$ref": "#/$defs/digestRef"
    },
    "evidence-record": {
     "$ref": "#/$defs/digestRef"
    },
    "reason": {
     "$ref": "#/$defs/text"
    }
   },
   "not": {
    "required": [
     "observation",
     "observation-ref"
    ]
   }
  },
  "evidenceRecord": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "record-version",
    "check-ref",
    "check-digest",
    "subject-ref",
    "started",
    "finished",
    "outputs"
   ],
   "properties": {
    "record-version": {
     "const": "1"
    },
    "check-ref": {
     "$ref": "#/$defs/uri"
    },
    "check-digest": {
     "$ref": "#/$defs/digest"
    },
    "collector-id": {
     "type": "string",
     "minLength": 1
    },
    "subject-ref": {
     "$ref": "#/$defs/uri"
    },
    "target": {
     "type": "object",
     "minProperties": 1
    },
    "runner": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "id"
     ],
     "properties": {
      "id": {
       "type": "string",
       "minLength": 1
      },
      "version": {
       "type": "string"
      }
     }
    },
    "started": {
     "$ref": "#/$defs/dateTime"
    },
    "finished": {
     "$ref": "#/$defs/dateTime"
    },
    "exit-status": {
     "type": "integer"
    },
    "observation-digest": {
     "$ref": "#/$defs/digest"
    },
    "outputs": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "name",
       "digest"
      ],
      "properties": {
       "name": {
        "type": "string",
        "minLength": 1
       },
       "digest": {
        "$ref": "#/$defs/digest"
       },
       "media-type": {
        "type": "string",
        "minLength": 1
       },
       "size": {
        "type": "integer",
        "minimum": 0
       },
       "redacted": {
        "type": "boolean"
       }
      }
     }
    },
    "redactions": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/text"
     }
    },
    "note": {
     "$ref": "#/$defs/text"
    }
   }
  }
 }
}
