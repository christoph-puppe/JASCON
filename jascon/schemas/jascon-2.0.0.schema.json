{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://ns.jascon.net/schema/2.0.0",
 "title": "JASCON - normative kernel shapes (2.0.0: Risk and Check kernel types)",
 "description": "The ELEVEN kernel types + Deviation sub-object + content manifest, field by field per Handbook Appendix A / spec Appendix A. Kernel shapes are CLOSED (unevaluatedProperties: false): an unknown top-level field is a validation error - facets are the extension surface (D10). Objects carry no type discriminator; a conformant object matches EXACTLY ONE of the eleven type entry points (shape-disjointness is itself a conformance property, exercised by the conformance corpus). 2.0.0 - a major version by rule (D22 rev 3: kernel-shape changes ride majors), a superset in fact (every 1.0.0-valid object validates unchanged) - adds Risk (CP-RISK-1): the ex-ante record that ISO/IEC 27001 6.1.2-6.1.3, BSI 200-3 and NIST SP 800-30 all encode independently - a requirement selected by a consumer is justified by the Risks whose treatments name it. Rating SCALES stay facet-level (App. F Q14 holds for scoring); the risk's identity, owner, scenario, treatment decision, treating controls and residual-risk acceptance are kernel. Risk rules RISK-1..6 and RISK-13 (a residual-rating presupposes a rating) are conditionals of this schema; acceptance.date and review-due points in time are ISO 8601 / RFC 3339 strings, durations are positive integers. 2.0.0 also adds Check (CP-CHECK-1): what to observe on a platform and what the observation must satisfy - a typed fact contract (`observes`) and a flat conjunction of assertions from a CLOSED set of eleven comparators (`criteria`, primitive check-verdict, App. B.1.10), with `matches`/`matches-not` in the I-Regexp dialect (RFC 9485). The code that collects the facts is not kernel: it rides the Check in the stdlib facet collector@1. An Assessment MAY carry `check-results` - one row per Check run, the normalised observation inline so that every verdict is recomputable from the record - and a `tailoring-ref` naming the Tailoring whose bound parameter values the run used; a Finding MAY name the Check that raised it (`check-ref`). `evidenceRecord` is the shape of an evidence record file, which lives beside the bundle like a signature envelope: not an object, not a type.",
 "$defs": {
  "uri": {
   "type": "string",
   "minLength": 1
  },
  "digest": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}$"
  },
  "text": {
   "type": "object",
   "minProperties": 1,
   "propertyNames": {
    "pattern": "^[a-z]{2,3}(-[a-z0-9]{1,8})*$"
   },
   "additionalProperties": {
    "anyOf": [
     {
      "type": "string",
      "minLength": 1
     },
     {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "minLength": 1
      }
     }
    ]
   }
  },
  "predicate": {
   "anyOf": [
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "field-equals"
     ],
     "properties": {
      "field-equals": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "path",
        "value"
       ],
       "properties": {
        "path": {
         "type": "string",
         "minLength": 1
        },
        "value": {}
       }
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "param-equals"
     ],
     "properties": {
      "param-equals": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "name",
        "value"
       ],
       "properties": {
        "name": {
         "type": "string",
         "minLength": 1
        },
        "value": {}
       }
      }
     }
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "present"
     ],
     "properties": {
      "present": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "path"
       ],
       "properties": {
        "path": {
         "type": "string",
         "minLength": 1
        }
       }
      }
     }
    }
   ]
  },
  "modality": {
   "enum": [
    "unspecified",
    "may",
    "should",
    "must",
    "may-only",
    "should-not",
    "must-not"
   ]
  },
  "lifecycle": {
   "enum": [
    "draft",
    "active",
    "deprecated",
    "withdrawn"
   ]
  },
  "findingState": {
   "enum": [
    "open",
    "in-remediation",
    "closed"
   ]
  },
  "deviationType": {
   "enum": [
    "false-positive",
    "operational-requirement",
    "risk-adjustment",
    "vendor-dependency",
    "derogation"
   ]
  },
  "deviationState": {
   "enum": [
    "investigating",
    "pending",
    "approved",
    "withdrawn"
   ]
  },
  "responsibility": {
   "enum": [
    "provider",
    "customer",
    "shared",
    "inherited"
   ]
  },
  "mappingRelationship": {
   "enum": [
    "equal",
    "subset-of",
    "superset-of",
    "intersects",
    "supports",
    "conflicts",
    "supplements"
   ]
  },
  "mappingDirection": {
   "enum": [
    "source-to-target",
    "bidirectional"
   ]
  },
  "confidence": {
   "enum": [
    "draft",
    "reviewed",
    "authoritative"
   ]
  },
  "componentKind": {
   "enum": [
    "system",
    "service",
    "software",
    "hardware",
    "policy",
    "process"
   ]
  },
  "implementationStatus": {
   "enum": [
    "planned",
    "partial",
    "implemented",
    "not-applicable"
   ]
  },
  "assessmentResult": {
   "enum": [
    "satisfied",
    "not-satisfied",
    "inconclusive"
   ]
  },
  "elapsedUnit": {
   "enum": [
    "seconds",
    "minutes",
    "hours"
   ]
  },
  "calendarUnit": {
   "enum": [
    "days",
    "bizdays",
    "weeks",
    "months",
    "years"
   ]
  },
  "tightening": {
   "enum": [
    "lower",
    "higher",
    "none"
   ]
  },
  "decimalString": {
   "type": "string",
   "pattern": "^(-?[1-9][0-9]*(\\.[0-9]+)?|0(\\.[0-9]+)?|-0\\.[0-9]*[1-9][0-9]*)$"
  },
  "alias": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "scheme",
    "value"
   ],
   "properties": {
    "scheme": {
     "type": "string"
    },
    "value": {
     "type": "string"
    }
   }
  },
  "relation": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "type",
    "ref"
   ],
   "properties": {
    "type": {
     "anyOf": [
      {
       "enum": [
        "related",
        "required",
        "uses-term",
        "reference",
        "schema"
       ]
      },
      {
       "type": "string",
       "pattern": "^https?://."
      }
     ]
    },
    "ref": {
     "$ref": "#/$defs/uri"
    }
   }
  },
  "base": {
   "type": "object",
   "required": [
    "id",
    "version",
    "lifecycle"
   ],
   "properties": {
    "id": {
     "$ref": "#/$defs/uri"
    },
    "version": {
     "type": "string",
     "minLength": 1
    },
    "label": {
     "type": "string"
    },
    "title": {
     "$ref": "#/$defs/text"
    },
    "aliases": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/alias"
     }
    },
    "lifecycle": {
     "$ref": "#/$defs/lifecycle"
    },
    "canonical-alias": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "of"
      ],
      "properties": {
       "of": {
        "$ref": "#/$defs/uri"
       }
      }
     }
    },
    "replaces": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "ref",
       "mode"
      ],
      "properties": {
       "ref": {
        "$ref": "#/$defs/uri"
       },
       "mode": {
        "enum": [
         "revised",
         "split-from",
         "merged-into",
         "renamed"
        ]
       }
      }
     }
    },
    "relations": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/relation"
     }
    },
    "facets": {
     "type": "object",
     "minProperties": 1,
     "propertyNames": {
      "pattern": "@[0-9]+$"
     },
     "additionalProperties": {
      "type": "object"
     }
    },
    "annotations": {
     "type": "object",
     "minProperties": 1
    }
   }
  },
  "parameter": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "name",
    "type"
   ],
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1
    },
    "type": {
     "enum": [
      "string",
      "integer",
      "decimal",
      "boolean",
      "date",
      "datetime",
      "uri",
      "code",
      "choice",
      "list",
      "range",
      "elapsed-duration",
      "calendar-period"
     ]
    },
    "label": {
     "type": "string"
    },
    "default": {},
    "tightening": {
     "$ref": "#/$defs/tightening"
    },
    "choices": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "value"
      ],
      "properties": {
       "value": {},
       "label": {
        "$ref": "#/$defs/text"
       }
      }
     }
    },
    "cardinality": {
     "enum": [
      "one",
      "many"
     ]
    },
    "min": {
     "type": "number"
    },
    "max": {
     "type": "number"
    },
    "num": {
     "type": "number"
    },
    "unit": {
     "type": "string"
    },
    "calendar-ref": {
     "$ref": "#/$defs/uri"
    },
    "timezone": {
     "type": "string"
    },
    "cutoff": {
     "type": "string"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "type": {
        "const": "elapsed-duration"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "required": [
       "num",
       "unit"
      ],
      "properties": {
       "unit": {
        "$ref": "#/$defs/elapsedUnit"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "calendar-period"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "required": [
       "num",
       "unit",
       "calendar-ref"
      ],
      "properties": {
       "unit": {
        "$ref": "#/$defs/calendarUnit"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "choice"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "required": [
       "choices"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "decimal"
       }
      },
      "required": [
       "type"
      ]
     },
     "then": {
      "properties": {
       "default": {
        "$ref": "#/$defs/decimalString"
       }
      }
     }
    }
   ]
  },
  "statement": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "modality",
    "obligated-parties",
    "prose"
   ],
   "properties": {
    "id": {
     "type": "string",
     "minLength": 1
    },
    "modality": {
     "$ref": "#/$defs/modality"
    },
    "obligated-parties": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/uri"
     }
    },
    "parameters": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/parameter"
     }
    },
    "prose": {
     "$ref": "#/$defs/text"
    }
   }
  },
  "deviation": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "type",
    "state",
    "rationale",
    "approver-ref",
    "opened"
   ],
   "properties": {
    "type": {
     "$ref": "#/$defs/deviationType"
    },
    "state": {
     "$ref": "#/$defs/deviationState"
    },
    "rationale": {
     "$ref": "#/$defs/text"
    },
    "approver-ref": {
     "$ref": "#/$defs/uri"
    },
    "opened": {
     "$ref": "#/$defs/date"
    },
    "refs": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/uri"
     }
    }
   }
  },
  "operation": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "op",
    "requirement-ref"
   ],
   "properties": {
    "op": {
     "enum": [
      "set-parameter",
      "set-modality",
      "set-field",
      "replace-prose",
      "add-relation",
      "remove-relation",
      "attach-facet",
      "detach-facet"
     ]
    },
    "requirement-ref": {
     "$ref": "#/$defs/uri"
    },
    "statement-id": {
     "type": "string"
    },
    "parameter": {
     "type": "string"
    },
    "value": {},
    "modality": {
     "$ref": "#/$defs/modality"
    },
    "field": {
     "type": "string"
    },
    "prose": {
     "$ref": "#/$defs/text"
    },
    "intent": {
     "enum": [
      "editorial",
      "substantive"
     ]
    },
    "relation": {
     "$ref": "#/$defs/relation"
    },
    "facet": {
     "type": "string"
    },
    "payload": {},
    "override": {
     "$ref": "#/$defs/uri"
    },
    "deviation": {
     "$ref": "#/$defs/deviation"
    },
    "deviation-ref": {
     "type": "string"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "op": {
        "const": "set-parameter"
       }
      },
      "required": [
       "op"
      ]
     },
     "then": {
      "required": [
       "parameter",
       "value"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "op": {
        "const": "set-modality"
       }
      },
      "required": [
       "op"
      ]
     },
     "then": {
      "required": [
       "modality"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "op": {
        "const": "replace-prose"
       }
      },
      "required": [
       "op"
      ]
     },
     "then": {
      "required": [
       "prose",
       "intent"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "op": {
        "const": "set-field"
       }
      },
      "required": [
       "op"
      ]
     },
     "then": {
      "required": [
       "field",
       "value"
      ],
      "properties": {
       "field": {
        "enum": [
         "title",
         "label",
         "annotations"
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "op": {
        "const": "attach-facet"
       }
      },
      "required": [
       "op"
      ]
     },
     "then": {
      "required": [
       "facet",
       "payload"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "op": {
        "const": "detach-facet"
       }
      },
      "required": [
       "op"
      ]
     },
     "then": {
      "required": [
       "facet"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "op": {
        "const": "add-relation"
       }
      },
      "required": [
       "op"
      ]
     },
     "then": {
      "required": [
       "relation"
      ]
     }
    },
    {
     "if": {
      "properties": {
       "op": {
        "const": "remove-relation"
       }
      },
      "required": [
       "op"
      ]
     },
     "then": {
      "required": [
       "relation"
      ]
     }
    }
   ]
  },
  "requirement": {
   "allOf": [
    {
     "$ref": "#/$defs/base"
    },
    {
     "required": [
      "statements"
     ],
     "properties": {
      "statements": {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/$defs/statement"
       }
      },
      "deviations": {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/$defs/deviation"
       }
      }
     }
    }
   ],
   "unevaluatedProperties": false
  },
  "requirementSet": {
   "allOf": [
    {
     "$ref": "#/$defs/base"
    },
    {
     "required": [
      "members"
     ],
     "properties": {
      "members": {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "ref"
        ],
        "properties": {
         "ref": {
          "$ref": "#/$defs/uri"
         },
         "sequence": {
          "type": "integer"
         }
        }
       }
      }
     }
    }
   ],
   "unevaluatedProperties": false
  },
  "tailoring": {
   "allOf": [
    {
     "$ref": "#/$defs/base"
    },
    {
     "required": [
      "selects"
     ],
     "properties": {
      "selects": {
       "type": "array",
       "minItems": 1,
       "items": {
        "anyOf": [
         {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "set-ref"
          ],
          "properties": {
           "set-ref": {
            "$ref": "#/$defs/uri"
           }
          }
         },
         {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "predicate"
          ],
          "properties": {
           "predicate": {
            "$ref": "#/$defs/predicate"
           }
          }
         }
        ]
       }
      },
      "excludes": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "ref"
        ],
        "properties": {
         "ref": {
          "$ref": "#/$defs/uri"
         },
         "rationale": {
          "$ref": "#/$defs/text"
         }
        }
       }
      },
      "operations": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/operation"
       }
      },
      "deviations": {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/$defs/deviation"
       }
      }
     }
    }
   ],
   "unevaluatedProperties": false
  },
  "mapping": {
   "allOf": [
    {
     "$ref": "#/$defs/base"
    },
    {
     "required": [
      "source-ref",
      "target-ref",
      "relationship",
      "direction",
      "confidence",
      "provenance"
     ],
     "properties": {
      "source-ref": {
       "$ref": "#/$defs/uri"
      },
      "target-ref": {
       "$ref": "#/$defs/uri"
      },
      "source-scope": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "string",
        "pattern": "^statement:"
       }
      },
      "target-scope": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "string",
        "pattern": "^statement:"
       }
      },
      "relationship": {
       "$ref": "#/$defs/mappingRelationship"
      },
      "direction": {
       "$ref": "#/$defs/mappingDirection"
      },
      "confidence": {
       "$ref": "#/$defs/confidence"
      },
      "rationale": {
       "$ref": "#/$defs/text"
      },
      "provenance": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "author-ref",
        "date"
       ],
       "properties": {
        "author-ref": {
         "$ref": "#/$defs/uri"
        },
        "date": {
         "type": "string",
         "minLength": 1
        }
       }
      },
      "evidence-refs": {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/$defs/uri"
       }
      }
     }
    }
   ],
   "unevaluatedProperties": false
  },
  "component": {
   "allOf": [
    {
     "$ref": "#/$defs/base"
    },
    {
     "required": [
      "kind"
     ],
     "properties": {
      "kind": {
       "$ref": "#/$defs/componentKind"
      },
      "product-version": {
       "type": "string",
       "minLength": 1
      },
      "members": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "component-ref"
        ],
        "properties": {
         "component-ref": {
          "$ref": "#/$defs/uri"
         },
         "context": {
          "type": "string"
         }
        }
       }
      },
      "capabilities": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "id"
        ],
        "properties": {
         "id": {
          "type": "string"
         },
         "requirement-ref": {
          "$ref": "#/$defs/uri"
         },
         "statement-ids": {
          "type": "array",
          "minItems": 1,
          "items": {
           "type": "string"
          }
         },
         "description": {
          "$ref": "#/$defs/text"
         },
         "parameter-bindings": {
          "type": "object"
         }
        }
       }
      },
      "authorizations": {
