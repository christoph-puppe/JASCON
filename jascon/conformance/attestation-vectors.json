{
  "description": "Bi-modal verification (D7/D3): FULL MATCH = content-manifest digest AND all subject package-digests verify (byte-identical delivery). SEMANTIC MATCH = package bytes differ (re-serialization, re-indentation, annotation changes) but every subject's semantic-digest (JCS minus annotations) verifies - the signature survives legitimate repackaging. TAMPER = any subject semantic-digest fails - meaning changed, nothing survives. Attestations live beside the manifest; nothing signed contains its own signature. binds-vectors (backlog #46, 2026-11-14): the primitive applied to a bundle, as a validator applies it to every Attestation it reads with one - those beside the manifest (D3.1) and any a manifest lists. `manifest-digest` is the digest of the delivered manifest, `kept-packs` the digests of the pack manifests the bundle keeps. Each subject is `match` (an object of the bundle carries the signed semantic digest: the object of that id when the subject names one, any object when it is a bare digest), `differs` (the object of that id carries another digest) or `absent` (no such object, or no object with that digest). `expected-manifest` is `this`, `kept-pack` or `other`. All subjects match and the manifest is this one or a kept pack's = full-match; all match and the manifest is another = semantic-match; anything else = fail. `expected-failure` says whether the bundle fails: it does when the verdict is `fail` and the Attestation's lifecycle is `active` - a draft, deprecated or withdrawn Attestation that does not bind is reported and fails nothing. An implementation is held to the verdict, to which manifest is bound, to the status of every subject in order, and to whether the bundle fails.",
  "vectors": [
    { "name": "full-match",
      "scenario": {
        "subject": { "id": "https://ex.org/req/1", "version": "1", "lifecycle": "active",
          "statements": [ { "id": "s1", "modality": "must",
            "obligated-parties": ["https://ex.org/party/org"], "prose": { "en": "X must be done." } } ] },
        "delivered-mutation": "none" },
      "expected": "full-match" },
    { "name": "semantic-match-reindented",
      "scenario": {
        "subject": { "id": "https://ex.org/req/1", "version": "1", "lifecycle": "active",
          "statements": [ { "id": "s1", "modality": "must",
            "obligated-parties": ["https://ex.org/party/org"], "prose": { "en": "X must be done." } } ] },
        "delivered-mutation": "reindent",
        "note": "package-digest changes (bytes moved), semantic-digest identical" },
      "expected": "semantic-match" },
    { "name": "semantic-match-annotation-added",
      "scenario": {
        "subject": { "id": "https://ex.org/req/1", "version": "1", "lifecycle": "active",
          "statements": [ { "id": "s1", "modality": "must",
            "obligated-parties": ["https://ex.org/party/org"], "prose": { "en": "X must be done." } } ] },
        "delivered-mutation": "annotation-added",
        "note": "annotations are digest-excluded chrome - adding them is legitimate repackaging" },
      "expected": "semantic-match" },
    { "name": "tamper-modality-eased",
      "scenario": {
        "subject": { "id": "https://ex.org/req/1", "version": "1", "lifecycle": "active",
          "statements": [ { "id": "s1", "modality": "must",
            "obligated-parties": ["https://ex.org/party/org"], "prose": { "en": "X must be done." } } ] },
        "delivered-subject": { "id": "https://ex.org/req/1", "version": "1", "lifecycle": "active",
          "statements": [ { "id": "s1", "modality": "should",
            "obligated-parties": ["https://ex.org/party/org"], "prose": { "en": "X must be done." } } ] },
        "delivered-mutation": "modality must->should after signing" },
      "expected": "tamper" },
    { "name": "tamper-prose-edited",
      "scenario": {
        "subject": { "id": "https://ex.org/req/1", "version": "1", "lifecycle": "active",
          "statements": [ { "id": "s1", "modality": "must",
            "obligated-parties": ["https://ex.org/party/org"], "prose": { "en": "X must be done." } } ] },
        "delivered-subject": { "id": "https://ex.org/req/1", "version": "1", "lifecycle": "active",
          "statements": [ { "id": "s1", "modality": "must",
            "obligated-parties": ["https://ex.org/party/org"], "prose": { "en": "X may be done." } } ] },
        "delivered-mutation": "prose edited after signing" },
      "expected": "tamper" }
  ],
