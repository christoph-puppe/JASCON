 "path-vectors": [
  {
   "ref": "attestation.dsse",
   "beside": true,
   "why": "a file name beside the manifest"
  },
  {
   "ref": "sig/attestation.dsse",
   "beside": true,
   "why": "a file in a folder below the manifest's"
  },
  {
   "ref": "a..b.dsse",
   "beside": true,
   "why": "two dots inside a name are no `..` segment"
  },
  {
   "ref": "..a",
   "beside": true,
   "why": "nor at the start of a longer name"
  },
  {
   "ref": "./attestation.dsse",
   "beside": true,
   "why": "a `.` segment stays in the folder"
  },
  {
   "ref": "../attestation.dsse",
   "beside": false,
   "why": "`..` leaves the folder"
  },
  {
   "ref": "sig/../attestation.dsse",
   "beside": false,
   "why": "a `..` segment anywhere is refused, also where it would come back"
  },
  {
   "ref": "sig/..",
   "beside": false,
   "why": "a trailing `..` segment"
  },
  {
   "ref": "..",
   "beside": false,
   "why": "`..` alone"
  },
  {
   "ref": "/etc/attestation.dsse",
   "beside": false,
   "why": "an absolute path"
  },
  {
   "ref": "C:attestation.dsse",
   "beside": false,
   "why": "a drive letter (it reads as a scheme)"
  },
  {
   "ref": "c:\\attestation.dsse",
   "beside": false,
   "why": "a Windows path"
  },
  {
   "ref": "https://example.org/attestation.dsse",
   "beside": false,
   "why": "a URL: nothing beside the manifest has a scheme"
  },
  {
   "ref": "sig\\attestation.dsse",
   "beside": false,
   "why": "a backslash: Windows reads it as a folder, every other system as part of a name"
  },
  {
   "ref": "K:x",
   "beside": true,
   "why": "dialect trap: the Kelvin sign is no ASCII letter, so this is no scheme (Python's re.I and .NET's IgnoreCase would read it as K)"
  },
  {
   "ref": "sig/..\n",
   "beside": true,
   "why": "dialect trap: `..` followed by a line break is no `..` segment (Python's and .NET's `$` match before a final line break)"
  }
 ],
