{
  "description": "State machines and identity events (backlog #18 coverage). Deviation (C.3b): investigating -> pending -> approved | withdrawn; terminal states are terminal - re-litigation is a NEW Deviation. Finding (C.3): open -> in-remediation -> closed; closed is terminal (dispositions are Deviations, not extra states); direct open -> closed is legal (finding resolved without remediation phase). Identity (D2): canonical-alias = same content, substitution allowed; replaces = lineage, substitution NEVER automatic. Relationship composition (C.5 floor): equal chains; supplements never chains; everything else degrades to the honest floor (supports). Draft members (backlog #86, DRAFT-1): `draft-members` - each case is a mini-bundle; `expected` lists [Set id, number of draft members] for every ACTIVE Set that lists members whose lifecycle is draft, in the order of the ids. It is a report: a draft may be used, and nothing fails by it. Withdrawn references (backlog #93, WITHDRAWN-1): `withdrawn-references` - each case is a mini-bundle; `expected` lists [object id, edge, id of the withdrawn object] for every edge by which an object in force leans on an object the bundle holds as withdrawn: the objects in the order of their ids, the edges in the order of the table, the entries in the order of the document. Held, on an object whose own lifecycle is not withdrawn: a Tailoring's `selects set-ref`, `excludes ref` and `operation requirement-ref`; a Mapping's `source-ref` and `target-ref`; a Component's `capability requirement-ref` and `member component-ref`; an Implementation's `component-ref`, `requirement-ref` and `inherited-from component-ref`; a Check's `requirement-ref`; a live Risk's `component-refs` and `tailoring-refs`. Not held: `replaces`, `canonical-alias` and `relations`, which keep the record; the members of a Set, which lists what its catalogue withdrew; an Assessment, a Finding and an Attestation, which record what was found or signed at a time; a Risk's treatments, which are RISK-11's; facet payloads. Each entry is an error of the bundle.",
  "deviation-transitions": [
    { "from": "investigating", "to": "pending", "valid": true },
    { "from": "pending", "to": "approved", "valid": true },
    { "from": "pending", "to": "withdrawn", "valid": true },
    { "from": "investigating", "to": "withdrawn", "valid": true },
    { "from": "approved", "to": "pending", "valid": false, "reason": "terminal is terminal - re-litigation is a new Deviation with its own record" },
    { "from": "withdrawn", "to": "approved", "valid": false },
    { "from": "pending", "to": "investigating", "valid": false, "reason": "no backwards moves" },
    { "from": "approved", "to": "withdrawn", "valid": false }
  ],
  "finding-transitions": [
    { "from": "open", "to": "in-remediation", "valid": true },
    { "from": "in-remediation", "to": "closed", "valid": true },
    { "from": "open", "to": "closed", "valid": true },
    { "from": "closed", "to": "open", "valid": false, "reason": "closed is terminal; a recurrence is a new Finding" },
    { "from": "in-remediation", "to": "open", "valid": false },
    { "from": "closed", "to": "in-remediation", "valid": false }
  ],
  "identity-events": [
    { "record": "canonical-alias", "substitution": "allowed", "reason": "identity equivalence, authority-asserted rebrand of the SAME content" },
    { "record": "replaces:revised", "substitution": "never-automatic", "reason": "a revision is a different object with history - auto-substituting silently corrupts implementations, findings, attestations, mappings, tailorings (P7-B4)" },
    { "record": "replaces:split-from", "substitution": "never-automatic" },
    { "record": "replaces:merged-into", "substitution": "never-automatic" },
    { "record": "replaces:renamed", "substitution": "never-automatic" }
  ],
  "relationship-composition": [
    { "a": "equal", "b": "equal", "composed": "equal", "reason": "only equal chains at full strength (C.5)" },
    { "a": "equal", "b": "supports", "composed": "supports" },
    { "a": "subset-of", "b": "subset-of", "composed": "supports", "reason": "the conformance FLOOR: everything but equal-chains degrades honestly toward supports; a richer table is Chapter 8's, and a tool may implement it, but MUST NOT claim stronger than the floor without it" },
    { "a": "intersects", "b": "equal", "composed": "supports" },
    { "a": "supplements", "b": "equal", "composed": null, "reason": "supplements is an attachment claim, not a crosswalk claim - it never chains (C.5); OLIR exports may down-translate the EDGE to supports, but no composed claim exists" },
    { "a": "equal", "b": "supplements", "composed": null },
    { "a": "conflicts", "b": "equal", "composed": "supports", "reason": "floor only - conflict propagation needs Chapter 8's table, never the floor rule" }
  ],
  "shape-disjointness": [
    { "name": "each-type-matches-exactly-one",
