     "requirement-ref": "https://ns.auth.gov/fw/req/1",
     "state": "open"
    }
   ],
   "expected-fails": 0,
   "rule": "no pin = 1.0.0 content: every 1.0.0 manifest stays valid, and a 1.0.0 tool keeps reading it"
  },
