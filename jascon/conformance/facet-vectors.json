      "id": "s1",
      "modality": "must",
      "obligated-parties": [
       "https://ex.org/party/org"
      ],
      "prose": {
       "en": "X."
      }
     }
    ],
    "facets": {
     "https://ns.jascon.net/stdlib/facet/statement-grammar@1": {
      "by-statement": {
       "s1": {
        "action": "verschlüsseln",
        "result": "Transport"
       }
      }
     }
    }
   },
   "expected": "valid"
  },
  {
