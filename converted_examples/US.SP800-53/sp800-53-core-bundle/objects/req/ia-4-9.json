   ],
   "prose": {
    "en": "Maintain the attributes for each uniquely identified individual, device, or service in {param:ia-04.09_odp}."
   },
   "parameters": [
    {
     "name": "ia-04.09_odp",
     "type": "string",
     "label": "protected central storage"
    }
   ]
  }
 ],
 "facets": {
  "https://ns.nist.gov/sp800-53/facet/narrative@1": {
   "guidance": [
    {
     "en": "For each of the entities covered in [IA-2](#ia-2), [IA-3](#ia-3), [IA-8](#ia-8) , and [IA-9](#ia-9) , it is important to maintain the attributes for each authenticated entity on an ongoing basis in a central (protected) store."
    }
   ]
  },
