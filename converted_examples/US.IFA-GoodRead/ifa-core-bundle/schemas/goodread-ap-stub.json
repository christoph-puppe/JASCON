        "ar"
       ]
      }
     }
    }
   },
   "tasks": {
    "type": "array",
    "items": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "title",
      "type",
      "source-doc"
     ],
     "properties": {
      "title": {
       "type": "string"
      },
      "type": {
       "type": "string"
      },
      "description": {
       "type": "object",
       "minProperties": 1,
       "additionalProperties": {
        "type": "string"
       }
      },
      "activities": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "remarks": {
       "type": "object",
       "minProperties": 1,
       "additionalProperties": {
        "type": "string"
       }
