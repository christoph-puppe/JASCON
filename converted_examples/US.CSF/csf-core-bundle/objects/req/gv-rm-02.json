   "prose": {
    "en": "Risk appetite and risk tolerance statements are established, communicated, and maintained"
   }
  }
 ],
 "facets": {
  "https://ns.nist.gov/csf/facet/examples@1": {
   "examples": [
    {
     "id": "GV.RM-02.015",
     "prose": {
      "en": "Determine and communicate risk appetite statements that convey expectations about the appropriate level of risk for the organization"
     }
    },
    {
     "id": "GV.RM-02.016",
     "prose": {
      "en": "Translate risk appetite statements into specific, measurable, and broadly understandable risk tolerance statements"
     }
    },
    {
     "id": "GV.RM-02.017",
     "prose": {
      "en": "Refine organizational objectives and risk appetite periodically based on known risk exposure and residual risk"
     }
    }
   ]
