   "examples": [
    {
     "id": "PR.PS-03.247",
     "prose": {
      "en": "Replace hardware when it lacks needed security capabilities or when it cannot support software with needed security capabilities"
     }
    },
    {
     "id": "PR.PS-03.248",
     "prose": {
      "en": "Define and implement plans for hardware end-of-life maintenance support and obsolescence"
     }
    },
    {
     "id": "PR.PS-03.249",
     "prose": {
