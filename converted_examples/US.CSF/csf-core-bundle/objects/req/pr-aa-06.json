   "id": "statement",
   "modality": "unspecified",
   "obligated-parties": [
    "https://ns.nist.gov/csf/party/organization"
   ],
   "prose": {
    "en": "Physical access to assets is managed, monitored, and enforced commensurate with risk"
   }
  }
 ],
 "facets": {
  "https://ns.nist.gov/csf/facet/examples@1": {
   "examples": [
    {
     "id": "PR.AA-06.211",
     "prose": {
      "en": "Use security guards, security cameras, locked entrances, alarm systems, and other physical controls to monitor facilities and restrict access"
     }
    },
    {
     "id": "PR.AA-06.212",
     "prose": {
      "en": "Employ additional physical security controls for areas that contain high-risk assets"
     }
    },
    {
     "id": "PR.AA-06.213",
     "prose": {
      "en": "Escort guests, vendors, and other third parties within areas that contain business-critical assets"
     }
    }
   ]
  },
  "https://ns.nist.gov/csf/facet/csf@1": {
   "risk-party": {
    "value": [
     "1st",
     "3rd"
    ],
    "remark": [
     "1st Party Risk",
     "3rd Party Risk"
    ]
   }
  }
 },
