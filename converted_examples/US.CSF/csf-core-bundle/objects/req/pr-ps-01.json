 "facets": {
  "https://ns.nist.gov/csf/facet/examples@1": {
   "examples": [
    {
     "id": "PR.PS-01.238",
     "prose": {
      "en": "Establish, test, deploy, and maintain hardened baselines that enforce the organization's cybersecurity policies and provide only essential capabilities (i.e., principle of least functionality)"
     }
    },
    {
     "id": "PR.PS-01.239",
     "prose": {
      "en": "Review all default configuration settings that may potentially impact cybersecurity when installing or upgrading software"
     }
    },
    {
     "id": "PR.PS-01.240",
     "prose": {
      "en": "Monitor implemented software for deviations from approved baselines"
     }
    }
   ]
  },
