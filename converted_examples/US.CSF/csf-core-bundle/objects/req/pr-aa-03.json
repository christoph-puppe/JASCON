      "en": "Require multifactor authentication"
     }
    },
    {
     "id": "PR.AA-03.201",
     "prose": {
      "en": "Enforce policies for the minimum strength of passwords, PINs, and similar authenticators"
     }
    },
    {
     "id": "PR.AA-03.202",
     "prose": {
      "en": "Periodically reauthenticate users, services, and hardware based on risk (e.g., in zero trust architectures)"
     }
    },
    {
     "id": "PR.AA-03.203",
