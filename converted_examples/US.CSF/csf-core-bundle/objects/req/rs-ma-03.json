 "facets": {
  "https://ns.nist.gov/csf/facet/examples@1": {
   "examples": [
    {
     "id": "RS.MA-03.314",
     "prose": {
      "en": "Further review and categorize incidents based on the type of incident (e.g., data breach, ransomware, DDoS, account compromise)"
     }
    },
    {
     "id": "RS.MA-03.315",
     "prose": {
      "en": "Prioritize incidents based on their scope, likely impact, and time-critical nature"
     }
    },
    {
     "id": "RS.MA-03.316",
     "prose": {
      "en": "Select incident response strategies for active incidents by balancing the need to quickly recover from an incident with the need to observe the attacker or conduct a more thorough investigation"
     }
    }
   ]
  },
