   "prose": {
    "de": "Strukturmodellierung MUSS eine Konsolidierung und Redundanzprüfung des Anforderungspakets ausführen."
   }
  }
 ],
 "facets": {
  "https://ns.jascon.net/stdlib/facet/statement-grammar@1": {
