   "prose": {
    "de": "Governance und Compliance MUSS konkrete und messbare Ziele für die Informationssicherheit auf Basis der identifizierten Rahmenbedingungen festlegen."
   }
  }
 ],
 "facets": {
  "https://ns.jascon.net/stdlib/facet/statement-grammar@1": {
   "by-statement": {
    "smt": {
     "action": "festlegen",
